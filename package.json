{
  "name": "constella",
  "version": "0.8.2",
  "description": "Constella — 情報整理デスクトップアプリ",
  "author": "Constella",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "gen:dark": "node scripts/gen-dark-css.mjs",
    "dev:preview": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "docs:sync": "node scripts/sync-help-docs.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:capture": "node scripts/capture-docs.mjs",
    "docs:media": "node scripts/pull-docs-media.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@fontsource/ibm-plex-sans-jp": "^5.2.8",
    "@fontsource/klee-one": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "dompurify": "^3.4.11",
    "electron-updater": "^6.6.2",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.17.0",
    "lucide-react": "^0.441.0",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.16.0",
    "nanoid": "^5.1.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.26.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "utif": "^3.1.0",
    "wavesurfer.js": "^7.12.8",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "markdown-it-mark": "^4.0.0",
    "postcss": "^8.4.41",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitepress": "^1.6.4"
  },
  "build": {
    "appId": "com.constella.app",
    "productName": "Constella",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/mac-adhoc-sign.cjs",
    "publish": {
      "provider": "github",
      "owner": "yyamada722",
      "repo": "constella"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!out/types-node",
      "!out/types-web"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Constella"
    },
    "portable": {
      "artifactName": "Constella-${version}-portable.exe"
    }
  }
}
